# Local backend only. Never commit server/.env.
HOST=127.0.0.1
PORT=8787
EXTENSION_ORIGINS=chrome-extension://replace-with-your-32-character-extension-id
GEMINI_API_KEY=replace-with-your-own-google-ai-studio-key
LOCAL_CLIENT_TOKEN=replace-with-base64url-encoded-32-random-bytes
GEMINI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_MS=45000
MAX_IMAGE_BYTES=4194304
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_MAX_ENTRIES=10000
TRUST_PROXY=false
